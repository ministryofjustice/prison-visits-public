<% content_for :page_title do %>
  <% if content_for?(:pagetitle) %>
    <%= page_title(yield(:pagetitle)) %>
  <% else %>
    <%= page_title(yield(:header)) %>
  <% end %>
<% end %>

<% content_for :head do %>
  <%= csrf_meta_tag %>
  <%= favicon_link_tag %>
  <%= stylesheet_link_tag('govuk-frontend/dist/govuk/govuk-frontend.min.css', media: 'all') %>
  <%= stylesheet_link_tag('application', media: 'all') %>
  <!--[if IE 8]>
    <%= stylesheet_link_tag('application-ie8', media: 'all') %>
    <meta http-equiv="X-UA-Compatible" content="IE=8" >
  <![endif]-->
<% end %>

<aside id="cookie-message">
  <p>
    <%= t('.cookies_intro_explanation') %>
  </p>
  <p>
    <%= t('.cookies_question') %>
  </p>
    <button id="accept-cookies" class="button"><%= t('.accept_cookies')%></button>
    <button id="reject-cookies" class="button"><%= t('.reject_cookies')%></button>
    <a class="mtp-cancel-button" href="cookies"><%= t('.view_more_information')%></a>
</aside>

<% @omit_header = true %>
<% content_for :after_header do %>
  <%= govuk_header do |header| %>
    <% header.with_service_navigation(
        service_name: t('app_title'),
        service_url: '/',
        html_attributes: { id: 'proposition-name' }
    ) %>
  <% end %>
<% end %>

<% content_for :body_end do %>
  <%= content_tag :div, nil, class: "js-AsyncGA", data: ga_tracking_data %>
  <%= content_tag :div, nil, class: "js-Sentry", data: { sentry_js_dsn: config_item(:sentry_js_dsn) } %>

  <!--[if lte IE 8]>
    <%= javascript_include_tag('application_ie') %>
  <![endif]-->

  <!--[if gte IE 9]><!-->
    <%= javascript_include_tag('application') %>
  <!--<![endif]-->


<% end %>

<% content_for :content do %>
  <main id="content">
    <div class="phase-banner phase-banner-beta">
      <%= t('.feedback_banner_html', url: 'https://visit-someone-in-prison.form.service.justice.gov.uk') %>
    </div>

    <header>
      <h1 class="heading-xlarge">
        <%= yield :header %>
      </h1>
    </header>

    <% if notice.present? %>
      <p class="error-summary">
        <%= notice %>
      </p>
    <% end %>

    <%= yield %>
  </main>
<% end %>

<% content_for :footer_support_links do %>
  <ul class="govuk-footer__inline-list">
    <li class="govuk-footer__inline-list-item">
      <%= link_to(t('.cookies'), cookies_path, class: 'govuk-footer__link') %>
    </li>
    <li class="govuk-footer__inline-list-item">
      <%= link_to(t('.ts_and_cs'), terms_and_conditions_path, class: 'govuk-footer__link') %>
    </li>
    <li class="govuk-footer__inline-list-item">
      <%= link_to(t('.privacy_policy'), privacy_policy_path, class: 'govuk-footer__link') %>
    </li>
    <li class="govuk-footer__inline-list-item">
      <%= t('.contact_us_html', url: 'https://visit-someone-in-prison.form.service.justice.gov.uk') %>
    </li>
    <% alternative_locales.each do |locale| %>
      <li class="govuk-footer__inline-list-item">
        <% if controller_name == 'errors' %>
          <%= link_to(t('language', locale: locale), "/#{response.status}?locale=#{locale}", class: 'govuk-footer__link') %>
        <% else %>
          <%= link_to(t('language', locale: locale), { locale: locale }, class: 'govuk-footer__link') %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<%= render(template: 'layouts/govuk_template') %>
